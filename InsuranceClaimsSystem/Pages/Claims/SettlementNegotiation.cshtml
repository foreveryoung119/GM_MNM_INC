@page "{claimId:int}"
@model SettlementNegotiationModel
@{
    ViewData["Title"] = "Settlement Negotiation";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>Step 4: Negotiation on Settlement</h2>
            <p class="text-muted">Negotiate and finalize the settlement amount</p>
        </div>
    </div>

    <partial name="_ClaimWorkflowStages" model="Model.Claim?.Status ?? ClaimStatus.ClaimIntimation" />

    <div class="card border-0 shadow-sm settlement-card">
        <div class="card-body p-4">
            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <div class="alert alert-success">@Model.StatusMessage</div>
            }
            @if (TempData["ErrorMessage"] is string errMsg && !string.IsNullOrWhiteSpace(errMsg))
            {
                <div class="alert alert-danger">@errMsg</div>
            }

            <div class="negotiation-status-banner @Model.CurrentNegotiationStatusCssClass mb-4">
                <span class="status-label">Negotiation Status</span>
                <span class="status-value">@Model.CurrentNegotiationStatusText</span>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <h5>Claim Details</h5>
                    <p><strong>Claim ID:</strong> @Model.Claim?.ClaimNumber</p>
                    <p><strong>Estimated Loss:</strong> UGX @(Model.Claim?.EstimatedLoss.ToString("N0") ?? "N/A")</p>
                </div>
                <div class="col-md-6">
                    <h5>Assessment</h5>
                    <p><strong>Assessor:</strong> @Model.Claim?.AssessorName</p>
                </div>
            </div>

            <hr />

            @if (User.IsInRole("Broker Company Officer"))
            {
                <div class="alert alert-info">
                    <i class="fas fa-eye"></i> You have view-only access at this stage.
                </div>
            }

            <form method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="NegotiationDate" class="form-label">Negotiation Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="NegotiationDate" name="NegotiationDate" value="@(Model.Claim?.NegotiationStartDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="ProposedSettlementAmountDisplay" class="form-label">Proposed Settlement Amount <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="ProposedSettlementAmountDisplay" inputmode="numeric" value="@((Model.Claim?.ApprovedAmount > 0 ? Model.Claim?.ApprovedAmount : Model.Claim?.EstimatedLoss)?.ToString("N0"))" placeholder="Initial amount" required />
                        <input type="hidden" id="ProposedSettlementAmount" name="ProposedSettlementAmount" value="@(Model.Claim?.ApprovedAmount > 0 ? Model.Claim?.ApprovedAmount : Model.Claim?.EstimatedLoss)" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="AgreedSettlementAmountDisplay" class="form-label">Agreed Settlement Amount <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="AgreedSettlementAmountDisplay" inputmode="numeric" value="@(Model.Claim?.SettledAmount > 0 ? Model.Claim?.SettledAmount?.ToString("N0") : "")" placeholder="Final amount to be paid" required />
                        <input type="hidden" id="AgreedSettlementAmount" name="AgreedSettlementAmount" value="@Model.Claim?.SettledAmount" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label for="NegotiationRemarks" class="form-label">Remarks Negotiation <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="NegotiationRemarks" name="NegotiationRemarks" rows="4" placeholder="Negotiation remarks..." required>@Model.Claim?.Notes</textarea>
                    </div>
                </div>

                <div class="form-actions">
                    @if (!User.IsInRole("Broker Company Officer"))
                    {
                        <button type="submit"
                                class="btn btn-success btn-lg"
                                formaction="?handler=Approve"
                                formmethod="post">
                            <i class="fas fa-handshake"></i> Approve Settlement
                        </button>
                        @if (Model.CanRejectSettlement)
                        {
                            <button type="button"
                                    class="btn btn-outline-danger btn-lg"
                                    data-bs-toggle="modal"
                                    data-bs-target="#rejectSettlementModal">
                                <i class="fas fa-times-circle"></i> Reject Settlement
                            </button>
                        }
                    }
                    <a asp-page="/Claims/DocumentSubmission" asp-route-claimId="@Model.Claim?.Id" class="btn btn-secondary btn-lg">
                        <i class="fas fa-arrow-left"></i> Back to Documents
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- Reject Settlement Confirmation Modal -->
<div class="modal" id="rejectSettlementModal" tabindex="-1" aria-labelledby="rejectSettlementModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="rejectSettlementModalLabel">
                    <i class="fas fa-times-circle me-2"></i> Confirm Settlement Rejection
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong> Rejecting the settlement will <strong>close this claim permanently</strong>. This action cannot be undone.
                </div>
                <form id="rejectForm" method="post" asp-page-handler="Reject">
                    <input type="hidden" name="claimId" value="@Model.Claim?.Id" />
                    <div class="mb-3">
                        <label for="RejectionReason" class="form-label fw-semibold">Reason for Rejection <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="RejectionReason" name="RejectionReason" rows="4"
                                  placeholder="Please provide a reason for rejecting this settlement..." required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="rejectForm" class="btn btn-danger">
                    <i class="fas fa-times-circle me-1"></i> Confirm Rejection
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.settlement-card,
.settlement-card:hover {
    transform: none !important;
}

.negotiation-status-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid transparent;
}

.negotiation-status-banner .status-label {
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.negotiation-status-banner .status-value {
    font-size: 1rem;
    font-weight: 700;
}

.status-under-negotiation {
    background: #fff8e1;
    border-color: #f1c40f;
    color: #8a6d00;
}

.status-agreed {
    background: #e8f7ee;
    border-color: #28a745;
    color: #1e7e34;
}

.status-rejected {
    background: #fdeaea;
    border-color: #dc3545;
    color: #a71d2a;
}

.form-actions {
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid #e0e0e0;
    display: flex;
    gap: 10px;
}
</style>

<script>
(function () {
    function formatWithCommas(val) {
        var num = val.replace(/,/g, '');
        if (num === '' || isNaN(num)) return val;
        return Number(num).toLocaleString('en-US');
    }

    function bindAmountField(displayId, hiddenId) {
        var display = document.getElementById(displayId);
        var hidden = document.getElementById(hiddenId);
        if (display && hidden) {
            display.addEventListener('input', function () {
                var raw = this.value.replace(/,/g, '');
                hidden.value = raw;
                var pos = this.selectionStart;
                var prevLen = this.value.length;
                this.value = formatWithCommas(this.value);
                this.selectionStart = this.selectionEnd = pos + (this.value.length - prevLen);
            });
        }
    }

    bindAmountField('ProposedSettlementAmountDisplay', 'ProposedSettlementAmount');
    bindAmountField('AgreedSettlementAmountDisplay', 'AgreedSettlementAmount');
})();
</script>
