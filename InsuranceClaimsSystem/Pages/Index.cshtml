@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-container">
    <!-- Header Card -->
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center">
                        <img src="@(Url.Content("~/images/gm-sugar-logo.svg"))" alt="GM Sugar Limited" class="me-3" style="height: 80px; width: auto;">
                        <div>
                            <h4 class="mb-0"><strong>GM Sugar Limited</strong></h4>
                            <p class="text-muted mb-0">Insurance Department</p>
                            <small class="text-muted">Plot 87, Njeru Division, Njeru Municipality, Nakibizi, Buikwe District, Jinja, Uganda</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-end">
                    <button class="btn btn-light rounded-circle p-3" style="font-size: 24px;">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <!-- Total Claims -->
        <div class="col-md-3">
            <a asp-page="/Claims/Index" class="text-decoration-none d-block h-100">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-3">
                        <div style="border-top: 4px solid #5a9d6f; padding-top: 15px;">
                            <div class="text-center mb-3">
                                <i class="fas fa-folder text-success" style="font-size: 40px;"></i>
                            </div>
                            <p class="text-center mb-2">
                                <strong style="font-size: 32px; color: #5a9d6f;">@Model.TotalClaims</strong>
                            </p>
                            <p class="text-center text-muted">Total Claims</p>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Pending Claims -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div style="border-top: 4px solid #f39c12; padding-top: 15px;">
                        <div class="text-center mb-3">
                            <i class="fas fa-hourglass-half" style="font-size: 40px; color: #f39c12;"></i>
                        </div>
                        <p class="text-center mb-2">
                            <strong style="font-size: 32px; color: #f39c12;">@Model.PendingClaims</strong>
                        </p>
                        <p class="text-center text-muted">Pending Claims</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Processing -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div style="border-top: 4px solid #3498db; padding-top: 15px;">
                        <div class="text-center mb-3">
                            <i class="fas fa-cog" style="font-size: 40px; color: #3498db;"></i>
                        </div>
                        <p class="text-center mb-2">
                            <strong style="font-size: 32px; color: #3498db;">@Model.ProcessingClaims</strong>
                        </p>
                        <p class="text-center text-muted">Processing</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Finalized -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div style="border-top: 4px solid #27ae60; padding-top: 15px;">
                        <div class="text-center mb-3">
                            <i class="fas fa-balance-scale" style="font-size: 40px; color: #27ae60;"></i>
                        </div>
                        <p class="text-center mb-2">
                            <strong style="font-size: 32px; color: #27ae60;">@Model.FinalizedClaims</strong>
                        </p>
                        <p class="text-center text-muted">Finalized</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cancelled Claims -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div style="border-top: 4px solid #e74c3c; padding-top: 15px;">
                        <div class="text-center mb-3">
                            <i class="fas fa-times-circle" style="font-size: 40px; color: #e74c3c;"></i>
                        </div>
                        <p class="text-center mb-2">
                            <strong style="font-size: 32px; color: #e74c3c;">@Model.CancelledClaims</strong>
                        </p>
                        <p class="text-center text-muted">Cancelled</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
